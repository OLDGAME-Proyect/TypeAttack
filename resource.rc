#include <windows.h>
#include "source/resource.h"

IDI_APP_ICON ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OLDGAME-Proyect"
            VALUE "FileDescription",  "Type Attack - A Terminal Typing Game"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "TypeAttack"
            VALUE "LegalCopyright",   "OLDGAME-Proyect  (C) 2026"
            VALUE "OriginalFilename", "TypeAttack.exe"
            VALUE "ProductName",      "Type Attack"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
